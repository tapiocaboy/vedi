# Horoscope AI chat — NVIDIA Nemotron via the NVIDIA Integrate API.
# Copy this file to ".env" and fill in your key (the .env file is gitignored).
#
# WARNING: in a pure client-side build this key is bundled into the shipped JS
# and is visible to anyone inspecting the app. For production, proxy the call
# through a serverless function that holds the key instead. The NVIDIA endpoint
# may also reject browser requests via CORS — a proxy solves that too.

# Get a key at https://build.nvidia.com/ (starts with "nvapi-")
NVIDIA_API_KEY=

# Optional: override the model slug.
# Default: nvidia/nemotron-3-super-120b-a12b  (fast, ~1-2s, factually solid)
# Note: nvidia/nemotron-3-ultra-550b-a55b times out on the hosted endpoint.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
